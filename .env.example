# MongoDB connection string — use its OWN database, separate from TaskPulse.
MONGODB_URI=mongodb://127.0.0.1:27017/salespulse

# Base URL used in notification email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies. Generate one: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-before-deploying

# Timezone that defines "today" for queues, reports and reminders.
APP_TIMEZONE=Africa/Lusaka

# Country code applied to local phone numbers for duplicate detection
# ("0977123456" → "260977123456").
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=260

# Optional: if set, the /api/cron/* endpoints accept
# `Authorization: Bearer <CRON_SECRET>` from an external scheduler.
# CRON_SECRET=
